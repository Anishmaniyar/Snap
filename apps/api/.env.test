PORT=3000

APP_BASE_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

IDEMPOTENCY_PROCESSING_TIMEOUT_MS=300000
EXECUTION_TIMEOUT_MS=60000

# Dedicated test database. The test suite refuses to run cleanup unless
# DATABASE_URL contains "test" (see tests/helpers.ts assertTestDatabase).
DATABASE_URL=postgresql://snap:snap_password@127.0.0.1:5433/snap_test

JWT_ACCESS_SECRET=test-access-secret-change-me
JWT_REFRESH_SECRET=test-refresh-secret-change-me

FRONTEND_ORIGIN=http://localhost:5173

NODE_ENV=test
